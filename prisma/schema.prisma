generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model Transhcans{
  id  Int      @id @default(autoincrement())
  pos_x  Float
  pos_y  Float
  state  String
  updated_at  DateTime @updatedAt
}

model Truck {
  id           Int      @id
  should_move  Boolean
  last_trigger DateTime?
}